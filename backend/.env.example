# Copie ce fichier en .env et remplis les valeurs réelles
# Ne commite JAMAIS le .env sur GitHub — seulement le .env.example

# URL de connexion PostgreSQL (fournie par Supabase dans Project Settings > Database)
DATABASE_URL=postgresql://postgres:[TON_MOT_DE_PASSE]@db.[TON_ID_PROJET].supabase.co:5432/postgres

# Clé secrète pour signer les tokens JWT — génère une chaîne aléatoire longue
# Dans le terminal : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplace_par_une_cle_secrete_longue

# Durée de validité d'un token en minutes (60 = 1 heure)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Algorithme de hashage JWT
ALGORITHM=HS256

# Cloudinary (pour les uploads audio/images) — récupère ces valeurs sur cloudinary.com
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret
